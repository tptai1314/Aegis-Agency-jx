# Role-completion sidecar written next to an external-baseline verdict cache (never committed).
*.roles.jsonl

# Configs generated by scripts/run_all.sh at run time (regenerated on every run).
configs/generated_*.yaml

# Pristine copy of the original idea/code drop (a duplicate of this tree plus zips and PDFs).
# Kept locally as the comparison reference; it is not project source.
/Idea_05_AegisAgency/

# LaTeX build artefacts. Sources (.tex/.bib/.md) and the compiled main.pdf are tracked;
# per-page render previews are regenerated with scripts/make_plots.py + latexmk.
AegisAgency_manuscript/figure_previews/
*.aux
*.out
*.toc

